{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [
    {
      "type": "dashboards",
      "title": "Observability",
      "tags": [
        "observability"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "Backend and frontend dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(up{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Targets up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 3,
      "targets": [
        {
          "expr": "count(up{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"}==0) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Targets down",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Requests / s",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 5,
      "targets": [
        {
          "expr": "(sum(rate(http_server_requests_seconds_count{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_seconds_count{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "5xx error ratio",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Avg latency",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum(count_over_time({namespace=~\"${namespace:regex}\",service=~\"${service:regex}\",level=~\"(?i)error\"}[$__range])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Error logs (selected range)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Request rate by service",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 9,
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\",status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "5xx rate by service",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 10,
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_sum{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"}[$__rate_interval])) / sum by (service) (rate(http_server_requests_seconds_count{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Avg latency by service",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 11,
      "targets": [
        {
          "expr": "max by (service) (http_server_requests_seconds_max{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"})",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Max latency by service",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "id": 12,
      "panels": [],
      "title": "JVM",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "id": 13,
      "targets": [
        {
          "expr": "sum by (service) (jvm_memory_used_bytes{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\",area=\"heap\"})",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Heap used",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 22
      },
      "id": 14,
      "targets": [
        {
          "expr": "max by (service) (process_cpu_usage{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"})",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Process CPU usage",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "id": 15,
      "targets": [
        {
          "expr": "max by (service) (jvm_threads_live_threads{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"})",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Live threads",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "id": 16,
      "targets": [
        {
          "expr": "sum by (service) (rate(jvm_gc_pause_seconds_sum{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "GC pause time (s per s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "id": 17,
      "targets": [
        {
          "expr": "sum by (service) (hikaricp_connections_active{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"})",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "DB connections active (Hikari)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 55
      },
      "id": 18,
      "panels": [],
      "title": "Logs",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "id": 19,
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"}[$__auto]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "title": "Log volume by level",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 64
      },
      "id": 20,
      "options": {
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"}",
          "refId": "A"
        }
      ],
      "title": "Logs",
      "type": "logs"
    },
    {
      "id": 21,
      "type": "row",
      "title": "Infrastructure",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "panels": []
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Node CPU usage",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{cluster=\"k3s-prod\",id=\"/\"}[$__rate_interval])) / max(machine_cpu_cores{cluster=\"k3s-prod\"})",
          "legendFormat": "node"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Node memory (working set)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{cluster=\"k3s-prod\",id=\"/\"})",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "max(machine_memory_bytes{cluster=\"k3s-prod\"})",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Network by namespace (rx + tx)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (rate(container_network_receive_bytes_total{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\"}[$__rate_interval]))",
          "legendFormat": "rx {{namespace}}"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace) (rate(container_network_transmit_bytes_total{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\"}[$__rate_interval]))",
          "legendFormat": "tx {{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Pod CPU (cores)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 47
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",pod=~\"(${service:regex})-.*\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Pod memory (working set)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\",pod=~\"(${service:regex})-.*\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 27,
      "type": "row",
      "title": "Trace → logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 76
      },
      "panels": []
    },
    {
      "id": 28,
      "type": "logs",
      "title": "Logs for trace id (paste it in the Trace ID box above; get it from a Tempo trace or the Frontend dashboard)",
      "description": "Matches the trace id in every service's JSON log line. Backend services log one line per API request with traceId and spanId.",
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 77
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{cluster=\"k3s-prod\",namespace=~\".+\"} |= \"$trace_id\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "exact",
        "prettifyLogMessage": true
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 42,
  "tags": [
    "observability",
    "backend",
    "k3s",
    "microservices"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "grafanacloud-posadskiy-prom",
          "value": "grafanacloud-prom"
        },
        "label": "Metrics",
        "name": "ds_prom",
        "options": [],
        "query": "prometheus",
        "regex": "/grafanacloud-posadskiy-prom/",
        "type": "datasource"
      },
      {
        "current": {
          "text": "grafanacloud-posadskiy-logs",
          "value": "grafanacloud-logs"
        },
        "label": "Logs",
        "name": "ds_loki",
        "options": [],
        "query": "loki",
        "regex": "/grafanacloud-posadskiy-logs/",
        "type": "datasource"
      },
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "definition": "label_values(container_network_receive_bytes_total{cluster=\"k3s-prod\"}, namespace)",
        "includeAll": true,
        "label": "Namespace",
        "multi": true,
        "name": "namespace",
        "options": [],
        "query": {
          "query": "label_values(container_network_receive_bytes_total{cluster=\"k3s-prod\"}, namespace)",
          "refId": "ns"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "regex": "/^(?!java-swing-tutor$|skill-repeater$).+/"
      },
      {
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "definition": "label_values(up{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\"}, service)",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": {
          "query": "label_values(up{cluster=\"k3s-prod\",namespace=~\"${namespace:regex}\"}, service)",
          "refId": "svc"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": "paste a trace id",
        "current": {
          "text": "paste a trace id",
          "value": "paste a trace id"
        },
        "options": [
          {
            "selected": true,
            "text": "paste a trace id",
            "value": "paste a trace id"
          }
        ],
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
