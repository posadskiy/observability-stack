{
  "uid": "frontend-web",
  "title": "Frontend — Web Overview",
  "tags": [
    "observability",
    "frontend",
    "faro"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "Real user monitoring from Grafana Faro: sessions, Core Web Vitals, JS errors, browser-side API latency, audience. Backend counterpart: Backend — Services Overview.",
  "links": [
    {
      "type": "dashboards",
      "title": "Observability",
      "tags": [
        "observability"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "Backend and frontend dashboards",
      "url": ""
    },
    {
      "type": "link",
      "title": "Frontend Observability app",
      "url": "/a/grafana-kowalski-app",
      "icon": "external link",
      "targetBlank": true,
      "keepTime": false,
      "includeVars": false,
      "asDropdown": false,
      "tooltip": "Sessions, user journeys, source-mapped errors"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "ds_loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": "/.*-logs$/",
        "refresh": 1,
        "hide": 2,
        "current": {
          "text": "grafanacloud-posadskiy-logs",
          "value": "grafanacloud-posadskiy-logs"
        },
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "ds_tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "regex": "",
        "refresh": 1,
        "hide": 2,
        "current": {
          "text": "grafanacloud-posadskiy-traces",
          "value": "grafanacloud-posadskiy-traces"
        },
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${ds_loki}"
        },
        "definition": "service_name",
        "query": {
          "label": "service_name",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{kind=~\".+\"}",
          "type": 1
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "regex": "/^(?!java-swing-tutor$|skill-repeater$).+/"
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": "paste a trace id",
        "current": {
          "text": "paste a trace id",
          "value": "paste a trace id"
        },
        "options": [
          {
            "selected": true,
            "text": "paste a trace id",
            "value": "paste a trace id"
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview — last range, per app",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sessions",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "count(sum by (session_id) (count_over_time({service_name=~\"${app:regex}\",kind=\"event\"} | logfmt session_id [$__range])))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Page loads",
      "description": "",
