    {
      "id": 5,
      "type": "stat",
      "title": "API error rate",
      "description": "Browser fetch/XHR calls answered with HTTP 4xx/5xx.",
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "(sum(count_over_time({service_name=~\"${app:regex}\",kind=\"event\"} |= \"faro.tracing\" | logfmt | event_data_http_response_status_code >= 400 [$__range])) or vector(0)) / sum(count_over_time({service_name=~\"${app:regex}\",kind=\"event\"} |= \"faro.tracing\" [$__range]))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
